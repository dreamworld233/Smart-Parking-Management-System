<view class="card {{selected ? 'card--on' : ''}}" bindtap="onCardTap">
  <view class="card__head">
    <view class="card__name">{{item.lot.name}}</view>
    <!-- 未签约没有价格：整格显示「--」，别渲染出半个「¥/时」 -->
    <view class="card__price">
      <text class="tnum">{{item.lot.signed ? '¥' + item.lot.pricing.firstHour : '--'}}</text>
      <text class="card__unit" wx:if="{{item.lot.signed}}">/时</text>
    </view>
  </view>

  <view class="card__meta">
    <text>{{item.distanceText}}</text>
    <text class="card__dot">·</text>
    <text>步行 {{item.walkText}}</text>
    <text class="card__dot">·</text>
    <text>余位 <text class="card__free {{item.freeClass}}">{{item.spotsText}}</text></text>
    <text class="card__dot">·</text>
    <text>综合 <text class="card__score tnum">{{item.score}}</text> 分</text>
  </view>

  <view class="card__tags" wx:if="{{item.sourceNotes.length || item.reasons.length}}">
    <!-- 数据来源标注：逐条来自 sourceNotes（公示价/运营声明/待上报/估算） -->
    <view
      wx:for="{{item.sourceNotes}}"
      wx:for-item="note"
      wx:key="*this"
      class="tag source"
    >{{note}}</view>

    <!--
      循环变量必须改名：默认的 `item` 会盖住外层的 item 属性，
      写成 `{{item.tone}}` 取到的是理由字符串，class 会静默变空、标签全掉色
    -->
    <view
      wx:for="{{item.reasons}}"
      wx:for-item="reason"
      wx:key="*this"
      class="tag {{item.tone}}"
    >{{reason}}</view>
  </view>

  <view class="card__actions" wx:if="{{showActions}}">
    <view class="act act--ghost" catchtap="onNavigate">导航前往</view>
    <view class="act act--primary" wx:if="{{item.lot.signed}}" catchtap="onReserve">预约车位</view>
  </view>
</view>
