<view class="wrap">
  <!-- 顶栏：列表态只有标题；详情态显示返回键 -->
  <view class="bar" style="top: {{navTop}}px">
    <view class="bar__back" wx:if="{{detail}}" bindtap="onBack">‹</view>
    <view class="bar__title">我的订单</view>
  </view>

  <!-- 详情视图（覆盖列表） -->
  <scroll-view class="body detail-body" wx:if="{{detail}}" scroll-y style="padding-top: {{bodyTop}}px">
    <view class="card">
      <view class="card__head">
        <view class="card__name">{{detail.lotName}}</view>
        <view class="tag {{detail.statusClass}}">{{detail.statusLabel}}</view>
      </view>
      <view class="card__sub">单号 {{detail.orderNo}}</view>

      <view class="row">
        <text class="row__k">车牌</text>
        <text>{{detail.plateText}}</text>
      </view>
      <view class="row">
        <text class="row__k">到达时刻</text>
        <text>{{detail.arriveText}}</text>
      </view>
      <view class="row">
        <text class="row__k">入场截止</text>
        <text>{{detail.deadlineText}}</text>
      </view>
    </view>

    <!-- 核销码：pending_entry 待入场才需要，放大展示 -->
    <view class="card" wx:if="{{detail.status === 'pending_entry'}}">
      <view class="card__title">入场核销码</view>
      <view class="code">{{detail.verifyCode}}</view>
      <view class="hint">到达后向车场出示此码或报车牌核销入场</view>
    </view>

    <view class="card">
      <view class="card__title">费用明细</view>
      <view class="row"><text class="row__k">预支停车费</text><text class="tnum">¥{{detail.parkingText}}</text></view>
      <view class="row"><text class="row__k">平台服务费</text><text class="tnum">¥{{detail.serviceText}}</text></view>
      <view class="row"><text class="row__k">合计</text><text class="tnum strong">¥{{detail.totalText}}</text></view>
      <view class="row refund" wx:if="{{detail.refundText}}"><text class="row__k">{{detail.refundText}}</text></view>
    </view>

    <view class="card">
      <view class="card__title">预约规则</view>
      <view class="rule">入场截止为到达时刻后 15 分钟，超时车位自动释放并记违约</view>
      <view class="rule">下单后 10 分钟内取消全额退还；之后按已占用时长退预支停车费，服务费不退</view>
      <view class="rule">实际停放费由车场闸机计收，平台不参与</view>
    </view>

    <view class="tail" />
  </scroll-view>

  <!-- 列表视图 -->
  <block wx:else>
    <state-view
      wx:if="{{state !== 'ready'}}"
      kind="{{state}}"
      text="{{state === 'empty' ? '还没有预约' : state === 'error' ? '加载失败' : '加载中'}}"
      hint="{{state === 'empty' ? '从车场详情「预约车位」下单' : state === 'error' ? '请检查网络后重试' : ''}}"
      actionText="{{state === 'error' ? '重试' : ''}}"
      bind:action="onRetry"
    />

    <scroll-view class="body list-body" wx:if="{{state === 'ready'}}" scroll-y style="padding-top: {{bodyTop}}px">
      <!-- 状态 tab 一行横滑 + 右侧时钟图标（点击弹日期区间） -->
      <view class="filter">
        <scroll-view class="filter__tabs" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="filter__chips">
            <view
              class="chip {{activeTab === item.key ? 'chip--on' : ''}}"
              wx:for="{{filterTabs}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onTabTap"
            >{{item.label}}</view>
          </view>
        </scroll-view>
        <view class="filter__date {{fromDate || toDate ? 'filter__date--on' : ''}}" bindtap="onDateTap">
          <text class="filter__date-icon">🕐</text>
        </view>
      </view>

      <view class="filter-empty" wx:if="{{!cards.length}}">当前筛选下暂无订单</view>
      <block wx:else>
        <view
          class="oc"
          wx:for="{{cards}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCardTap"
        >
          <view class="oc__head">
            <view class="oc__name">{{item.lotName}}</view>
            <view class="tag {{item.statusClass}}">{{item.statusLabel}}</view>
          </view>
          <view class="oc__sub">{{item.plateText}} · {{item.arriveText}}</view>
          <view class="oc__foot">
            <view class="oc__no">{{item.orderNo}}</view>
            <view class="oc__amount tnum">¥{{item.totalText}}</view>
          </view>
        </view>
        <view class="tail" />
      </block>
    </scroll-view>

    <!-- 日期区间弹层：点时钟图标弹出，选开始/结束日期 -->
    <view class="mask" wx:if="{{datePanel}}" bindtap="onCloseDate">
      <view class="dialog" catchtap="noop">
        <view class="dialog__title">按到达日期筛选</view>
        <view class="dialog__row">
          <picker mode="date" value="{{fromDate}}" bindchange="onFromDate">
            <view class="dialog__pick {{fromDate ? 'dialog__pick--set' : ''}}">{{fromDate || '开始日期'}}</view>
          </picker>
          <text class="dialog__sep">至</text>
          <picker mode="date" value="{{toDate}}" bindchange="onToDate">
            <view class="dialog__pick {{toDate ? 'dialog__pick--set' : ''}}">{{toDate || '结束日期'}}</view>
          </picker>
        </view>
        <view class="dialog__hint">选同一天即查单日；都留空则不限日期</view>
        <view class="dialog__btns">
          <view class="dialog__btn" bindtap="onCloseDate">完成</view>
          <view class="dialog__btn ghost" wx:if="{{fromDate || toDate}}" bindtap="onClearDate">清除筛选</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 详情吸底取消按钮。必须在 scroll-view 外：scroll-view 内的 absolute 锚到
       **滚动内容**（不是页面根），bottom 一算就浮在最后一张卡片中间，和内容重叠。
       位置也必须在 <block wx:else> 之后 —— 紧跟 scroll-view 的 wx:if 才是配对的
       wx:else，插在中间会让 wx:else 绑到按钮的 wx:if 上，列表反把详情盖住（真机踩到） -->
  <view class="btnbar" wx:if="{{detail && detail.cancellable}}">
    <view class="btn-danger" data-id="{{detail.id}}" bindtap="onCancel">取消预约</view>
  </view>
</view>
