.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

/* 顶栏：tab 页标题栏，z-index 必须写（Skyline 同级按 DOM 顺序绘制） */
.bar {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx 20rpx;
}

.bar__back {
  font-size: 40rpx;
  color: var(--color-primary);
  line-height: 1;
  /* 触摸区 ≥ 88rpx：padding 扩命中、负 margin 抵消（与 confirm 页同套路） */
  padding: 32rpx 28rpx;
  margin: -32rpx -28rpx;
}

.bar__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 内容滚动区。padding-top 由 TS 算成 px 内联传入（navTop + 顶栏高，见 onLoad），
   写死 rpx 会与胶囊下沿 px 不对齐，标题文字压进内容（真机踩到） */
.body {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.list-body {
  /* tabBar 是 absolute 覆盖层，列表要让它自己的高度，否则底部卡片被 tabBar 压住点不动 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
}

/* 详情视图：取消按钮在 scroll-view 内吸底（bottom 让出 tabBar），
   内容区要让出 tabBar + 按钮两层高度，否则最后一张卡被按钮盖住 */
.detail-body {
  padding-bottom: calc(var(--tabbar-h, 100rpx) + 140rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-card);
}

.card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card__name {
  font-size: var(--font-card-title);
  font-weight: 600;
  color: var(--color-text);
}

.card__sub {
  font-size: var(--font-micro);
  color: var(--color-text-weak);
  margin-top: 8rpx;
}

.card__title {
  font-size: var(--font-sub);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-body);
  color: var(--color-text-sub);
  padding: 12rpx 0;
}

.row__k {
  color: var(--color-text-sub);
}

.strong {
  font-weight: 700;
  color: var(--color-text);
}

.refund {
  color: var(--color-success);
  border-top: 2rpx solid var(--color-border);
  margin-top: 8rpx;
}

.code {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  text-align: center;
  color: var(--color-text);
  padding: 24rpx 0;
}

.hint {
  font-size: var(--font-micro);
  color: var(--color-text-weak);
  text-align: center;
  line-height: 1.6;
}

.rule {
  font-size: var(--font-micro);
  color: var(--color-text-weak);
  line-height: 1.6;
  margin-top: 8rpx;
}

.tail {
  height: 40rpx;
}

/* 详情页吸底取消按钮：Skyline 不支持 fixed，absolute 贴页面根节点；
   orders 是 tab 页，tabBar 是覆盖层，按钮要停在它上面（bottom 让出 --tabbar-h） */
.btnbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(var(--tabbar-h, 100rpx) + env(safe-area-inset-bottom));
  z-index: 1;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
  border-top: 2rpx solid var(--color-border);
}

.btn-danger {
  padding: 20rpx 0;
  text-align: center;
  background: var(--color-danger);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  font-weight: 600;
}

/* 筛选区：状态 tab 一行横滑 + 右侧时钟图标 */
.filter {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-3);
}

.filter__tabs {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  /* Skyline 的 scroll-view scroll-x 不靠内容撑高：不给高度会被压成 0，chips 全裁掉 */
  height: 64rpx;
}

.filter__chips {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  height: 100%;
  padding-right: 8rpx;
}

.filter .chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: var(--font-tag);
  color: var(--color-text-sub);
}

.filter .chip--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 时钟图标按钮：有区间时高亮 */
.filter__date {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter__date--on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.filter__date-icon {
  font-size: 32rpx;
  line-height: 1;
}

.filter-empty {
  padding: var(--space-6) 0;
  text-align: center;
  font-size: var(--font-sub);
  color: var(--color-text-weak);
}

/* 日期区间弹层 */
.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 600rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-6);
}

.dialog__title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}

.dialog__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dialog__pick {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-card);
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  font-size: var(--font-sub);
  color: var(--color-text-weak);
}

.dialog__pick--set {
  color: var(--color-text);
  border-color: var(--color-primary);
}

.dialog__sep {
  font-size: var(--font-sub);
  color: var(--color-text-weak);
}

.dialog__hint {
  font-size: var(--font-micro);
  color: var(--color-text-weak);
  margin-top: var(--space-3);
}

.dialog__btns {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.dialog__btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  font-weight: 600;
}

.dialog__btn.ghost {
  flex: 1.2;
  background: var(--color-bg);
  color: var(--color-danger);
  font-weight: 400;
}

/* 列表卡片 */
.oc {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-card);
}

.oc__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.oc__name {
  font-size: var(--font-card-title);
  font-weight: 600;
  color: var(--color-text);
}

.oc__sub {
  font-size: var(--font-sub);
  color: var(--color-text-sub);
  margin-top: 8rpx;
}

.oc__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--color-border);
}

.oc__no {
  font-size: var(--font-micro);
  color: var(--color-text-weak);
}

.oc__amount {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-text);
}

/* 状态标签配色 */
.tag {
  font-size: var(--font-tag);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}

.tag--primary {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.tag--success {
  color: var(--color-success);
  background: #f0fdf4;
}

.tag--warning {
  color: var(--color-warning);
  background: #fffbeb;
}

.tag--muted {
  color: var(--color-text-weak);
  background: var(--color-bg);
}
