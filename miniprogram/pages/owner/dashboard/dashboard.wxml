<view class="wrap">
  <state-view wx:if="{{state === 'loading'}}" kind="loading" text="正在加载车场看板…" />
  <state-view
    wx:elif="{{state === 'no_role'}}"
    kind="empty"
    text="当前是车主身份"
    hint="车场端功能需要车场管理员身份"
    action-text="选择身份"
    bind:action="onPickRole"
  />
  <state-view
    wx:elif="{{state === 'no_lot'}}"
    kind="empty"
    text="尚未绑定车场"
    hint="绑定车场后即可管理余位与预约"
    action-text="绑定车场"
    bind:action="onBindLot"
  />
  <state-view
    wx:elif="{{state === 'error'}}"
    kind="error"
    text="看板加载失败"
    hint="请检查网络后重试"
    action-text="重试"
    bind:action="onRetry"
  />

  <block wx:elif="{{state === 'ready'}}">
    <scroll-view class="page" scroll-y style="padding-top: {{navTop}}px">
      <view class="head">
        <view class="head__name">{{lotName}}</view>
        <view class="head__addr">{{lotAddress}}</view>
      </view>

      <!-- 三统计块 -->
      <view class="stats">
        <view class="stat">
          <view class="stat__v">{{stat.todayReservations}}</view>
          <view class="stat__k">今日预约</view>
        </view>
        <view class="stat">
          <view class="stat__v primary">{{stat.pendingEntry}}</view>
          <view class="stat__k">待核销</view>
        </view>
        <view class="stat">
          <view class="stat__v">¥{{stat.todayIncome}}</view>
          <view class="stat__k">今日收益</view>
        </view>
      </view>

      <!-- 趋势折线图（canvas 2d，Skyline 兼容；TS 内绘制）。范围与下方收益卡共用 rangeDays -->
      <view class="card">
        <view class="card__row card__row--head">
          <view class="card__title">近 {{rangeDays}} 日预约与收益</view>
          <view class="trend__legend">
            <view class="legend legend--blue">预约</view>
            <view class="legend legend--orange">收益</view>
          </view>
        </view>
        <view class="range">
          <view
            class="range__chip {{rangeDays === 7 ? 'range__chip--on' : ''}}"
            data-days="7"
            bindtap="onRangeTap"
          >近 7 日</view>
          <view
            class="range__chip {{rangeDays === 30 ? 'range__chip--on' : ''}}"
            data-days="30"
            bindtap="onRangeTap"
          >近 30 日</view>
        </view>
        <view class="trend">
          <canvas type="2d" id="trendChart" class="trend__canvas" bindtouchstart="onTrendTap"></canvas>
          <!-- 点击数据点浮层：显示该日预约数与净收益 -->
          <view class="trend__tip" wx:if="{{trendTip}}" style="left: {{trendTip.x}}px; top: {{trendTip.y}}px">
            <view class="trend__tip-date">{{trendTip.date}}</view>
            <view class="trend__tip-row">
              <view class="dot dot--blue"></view>
              <text>预约 {{trendTip.reservations}} 单</text>
            </view>
            <view class="trend__tip-row">
              <view class="dot dot--orange"></view>
              <text>收益 ¥{{trendTip.incomeText}}</text>
            </view>
          </view>
          <view class="trend__empty" wx:if="{{!trend.length}}">暂无趋势数据</view>
        </view>
      </view>

      <!-- 小程序收益明细：车场主最关心「用了小程序到手多少钱」。
           口径 = 预支停车费 − 退款；平台服务费归平台，单列一行注明，不计入净收益 -->
      <view class="card">
        <view class="card__row card__row--head">
          <view class="card__title">近 {{income.days}} 日小程序收益</view>
        </view>
        <view class="earn">
          <view class="earn__v">{{income.netSign}}¥{{income.netText}}</view>
          <view class="earn__k">净收益 · 预支停车费 − 退款</view>
        </view>
        <view class="row">
          <text class="row__k">预支停车费</text>
          <text class="tnum">¥{{income.prepaidText}}</text>
        </view>
        <view class="row">
          <text class="row__k">退款扣减</text>
          <text class="tnum">−¥{{income.refundText}}</text>
        </view>
        <view class="row">
          <text class="row__k">平台服务费（归平台）</text>
          <text class="tnum weak">¥{{income.serviceText}}</text>
        </view>
        <view class="row">
          <text class="row__k">区间预约 / 已核销</text>
          <text>{{income.reservationCount}} 单 / {{income.verifiedCount}} 单</text>
        </view>
        <view class="card__sub" wx:if="{{income.truncated}}">区间流水超过 1000 条，以上统计已截断</view>
      </view>

      <!-- 余位上报卡 -->
      <view class="card">
        <view class="card__row">
          <view>
            <view class="card__title">实时余位</view>
            <view class="card__sub">当前空闲 {{spotsText}}</view>
          </view>
          <view class="btn" bindtap="onOpenReport">上报</view>
        </view>
      </view>

      <!-- 待核销列表 -->
      <view class="card">
        <view class="card__row card__row--head">
          <view class="card__title">待核销</view>
          <view class="card__more" bindtap="onPendingTap">全部 ›</view>
        </view>
        <block wx:if="{{pendingList.length}}">
          <view
            wx:for="{{pendingList}}"
            wx:key="id"
            class="pending"
            data-id="{{item.id}}"
            bindtap="onPendingTap"
          >
            <view class="pending__plate">{{item.plateText}}</view>
            <view class="pending__arrive">{{item.arriveText}}</view>
            <view class="pending__code">{{item.verifyCode}}</view>
          </view>
        </block>
        <view wx:else class="card__empty">暂无待核销预约</view>
      </view>
    </scroll-view>

    <!-- 余位上报弹窗 -->
    <view class="mask" wx:if="{{reportDialog}}" bindtap="onCloseReport">
      <view class="dialog" catchtap="noop">
        <view class="dialog__title">上报实时余位</view>
        <input
          class="dialog__input {{inputInvalid ? 'dialog__input--invalid' : ''}}"
          type="number"
          value="{{reportInput}}"
          bindinput="onReportInput"
          placeholder="当前空闲车位数"
        />
        <view class="dialog__hint" wx:if="{{inputInvalid}}">请输入非负整数</view>
        <view class="dialog__btns">
          <view class="dialog__btn" bindtap="onCloseReport">取消</view>
          <view class="dialog__btn primary" bindtap="onConfirmReport">{{submitting ? '上报中…' : '上报'}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
