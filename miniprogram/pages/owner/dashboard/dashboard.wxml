<view class="wrap">
  <state-view wx:if="{{state === 'loading'}}" kind="loading" text="正在加载车场看板…" />
  <state-view
    wx:elif="{{state === 'no_role'}}"
    kind="empty"
    text="当前是车主身份"
    hint="车场端功能需要车场管理员身份"
    action-text="选择身份"
    bind:action="onPickRole"
  />
  <state-view
    wx:elif="{{state === 'no_lot'}}"
    kind="empty"
    text="尚未绑定车场"
    hint="由平台运营为你的账号绑定车场后即可使用"
  />
  <state-view
    wx:elif="{{state === 'error'}}"
    kind="error"
    text="看板加载失败"
    hint="请检查网络后重试"
    action-text="重试"
    bind:action="onRetry"
  />

  <block wx:elif="{{state === 'ready'}}">
    <view class="page">
      <view class="page__head">
        <view class="page__name">{{lot.name}}</view>
        <view class="page__addr">{{lot.address}}</view>
      </view>
      <view class="todo">今日预约 / 待核销 / 收入等统计将在此展示（下一阶段）</view>
    </view>
  </block>
</view>
