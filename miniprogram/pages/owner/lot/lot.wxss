.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

.page {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: var(--space-4);
  /* tabBar 是 absolute 覆盖层，由页面让出它的高度 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-card);
}

.card__title {
  font-size: var(--font-sub);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-4);
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-bg);
}

.row:last-child {
  border-bottom: none;
}

.row__k {
  font-size: var(--font-body);
  color: var(--color-text-sub);
  flex-shrink: 0;
}

.row__v {
  font-size: var(--font-body);
  color: var(--color-text);
  text-align: right;
  word-break: break-all;
}

.source {
  font-size: var(--font-micro);
  color: var(--color-warning);
  margin-top: var(--space-2);
  line-height: 1.6;
}

.fac {
  font-size: var(--font-body);
  color: var(--color-text-sub);
  padding: 8rpx 0;
}

/* 弹窗 */
.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 560rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-6);
}

.dialog__title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}

.dialog__input {
  height: 88rpx;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 0 24rpx;
  font-size: 30rpx;
}

.dialog__input--invalid {
  border-color: var(--color-danger);
}

.dialog__hint {
  font-size: var(--font-micro);
  color: var(--color-danger);
  margin-top: var(--space-2);
}

.dialog__btns {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.dialog__btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  background: var(--color-bg);
  color: var(--color-text-sub);
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
}

.dialog__btn.primary {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}
