<view class="wrap">
  <view class="bar" style="top: {{searchTop}}px">
    <view class="bar__back" bindtap="onBack">‹</view>
    <input
      class="bar__input"
      value="{{keyword}}"
      placeholder="搜目的地 / 车场名"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <view class="bar__cancel" bindtap="onBack">取消</view>
  </view>

  <!-- 输入联想候选：在搜索栏正下方，替代历史。用户点选哪条就用哪条的坐标，
       不再静默拿接口首条（2026-09-15 改：suggestion + 显式选择）。
       用普通 view 而非 scroll-view：Skyline 下绝对定位的 scroll-view 只给
       max-height 不给 height 会把高度算成 0，列表整块看不见（2026-09-15 真机反馈）。
       可见性必须绑 state === 'idle'：候选只在「还没搜」时有意义，一旦进了搜索态，
       不管 candidates 里还剩什么都不能显示 —— 只靠 candidates.length 会有陈旧
       resolve 把列表救回来的路径（真机反馈：点选后候选框不关） -->
  <view class="suggest" wx:if="{{state === 'idle' && candidates.length}}" style="top: {{mapTop}}px">
    <view
      class="suggest__item"
      wx:for="{{candidates}}"
      wx:key="index"
      data-idx="{{index}}"
      bindtap="onCandidateTap"
    >
      <view class="suggest__title">{{item.title}}</view>
      <view class="suggest__addr">{{item.address}}</view>
    </view>
  </view>

  <!-- 还没搜过：只出历史，不出地图（少一次原生组件创建）。候选开着时历史让位 -->
  <view class="hist" wx:if="{{state === 'idle' && !candidates.length}}" style="padding-top: {{mapTop}}px">
    <view class="hist__title" wx:if="{{history.length}}">历史搜索</view>
    <view class="hist__list" wx:if="{{history.length}}">
      <view
        wx:for="{{history}}"
        wx:key="*this"
        class="hist__item"
        data-kw="{{item}}"
        bindtap="onHistoryTap"
      >{{item}}</view>
    </view>
    <view class="hist__empty" wx:else>输入目的地或车场名，找它周边的停车场</view>
  </view>

  <map
    wx:if="{{state !== 'idle'}}"
    class="wrap__map"
    style="top: {{mapTop}}px; height: {{mapHeight}}px"
    latitude="{{centerLat}}"
    longitude="{{centerLng}}"
    scale="15"
    markers="{{markers}}"
    bindmarkertap="onPinTap"
  />

  <view
    class="sheet"
    wx:if="{{state !== 'idle'}}"
    style="height: {{sheetHeight}}px; padding-bottom: {{safeBottom}}px"
  >
    <!-- 详情占满面板，面板高度一个像素都不变，内容在内部自己滚（2026-09-14 决定） -->
    <lot-detail
      wx:if="{{detail}}"
      vm="{{detail}}"
      bind:back="onDetailBack"
      bind:navigate="onNavigate"
      bind:reserve="onDetailReserve"
    />

    <!-- 结果列表视图。详情是面板内的另一种内容，两者互斥，不该叠在一起 -->
    <block wx:else>
      <view class="sheet__head" wx:if="{{state === 'ready'}}">{{cards.length}} 个车场</view>

      <!-- 排序 chips 放进面板（与首页统一） -->
      <view class="chips-row" wx:if="{{state === 'ready'}}">
        <!-- 长标签：UI 稿 §5.2 是「综合推荐 / 距离最近 / 费用最低 / 空位最多」，首页才用短的那套 -->
        <sort-chips variant="long" value="{{sortKey}}" bind:change="onSortChange" />
      </view>

      <view class="notice" wx:if="{{fallbackText}}">
        <text class="notice__text">{{fallbackText}}</text>
      </view>

      <state-view wx:if="{{state === 'loading'}}" kind="loading" text="正在检索…" />

      <state-view
        wx:elif="{{state === 'empty'}}"
        kind="empty"
        text="目的地周边暂无停车场"
        hint="换个关键词，或直接输入目的地"
      />

      <state-view
        wx:elif="{{state === 'error'}}"
        kind="error"
        text="检索失败"
        hint="请检查网络后重试"
        action-text="重试"
        bind:action="onRetry"
      />

      <scroll-view
        wx:elif="{{state === 'ready'}}"
        class="sheet__list"
        scroll-y
        scroll-into-view="{{intoView}}"
        scroll-with-animation
      >
        <!-- 每张卡片套一层带 id 的 view：scroll-into-view 按 id 找目标，点图钉时要能滚到它 -->
        <view wx:for="{{cards}}" wx:key="lot.id" id="card{{index}}">
          <lot-card
            item="{{item}}"
            selected="{{item.lot.id === selectedId}}"
            show-actions
            bind:cardtap="onCardTap"
            bind:navigate="onNavigate"
            bind:reserve="onReserve"
          />
        </view>
        <view class="sheet__tail" />
      </scroll-view>
    </block>
  </view>
</view>
